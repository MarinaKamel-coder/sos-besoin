# Copiez ce fichier vers .env.local et remplissez vos propres valeurs
# Chaque développeur doit avoir sa propre base de données — une BD de dev non partegée est recommandée pour éviter les conflits de données

# Chaîne de connexion PostgreSQL (locale ou branche Neon/Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sos_besoin_dev"

# Clerk — obtenez vos clés sur https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# URLs de redirection Clerk (laisser telles quelles pour le dev local)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:3000